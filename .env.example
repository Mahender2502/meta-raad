# Copy this file to .env and fill in values before running `docker compose up`.
# .env is loaded by the `backend` service (see docker-compose.yml env_file).

# --- ChromaDB (usually left as-is; matches the docker-compose service name) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- LLM provider selection -----------------------------------------------
# Undecided which model(s) we'll use yet. Leave as "stub" to run the backend
# and exercise /rag/query end-to-end without any API key. Switch to
# "openai" or "deepseek" (see app/services/llm_client.py) once a model is
# chosen — no code changes required elsewhere.
LLM_PROVIDER=stub
LLM_MODEL_NAME=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# --- API keys (only required for the provider selected above) --------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
