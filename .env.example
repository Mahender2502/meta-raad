# Meta-RAAD environment. Copy to .env (git-ignored) and fill in the values:
#   cp .env.example .env
# Loaded by the `backend` service (docker-compose.yml env_file). Never commit .env.

# --- LLM provider -----------------------------------------------------------
# gemini   : Google AI Studio free tier (needs GEMINI_API_KEY) <- demo default
# groq     : Groq free tier            (needs GROQ_API_KEY)
# cerebras : Cerebras free tier        (needs CEREBRAS_API_KEY)
# openai | deepseek : paid APIs        (need their keys below)
# stub     : no LLM call; retrieval still works, but the LLM panels show an error
LLM_PROVIDER=gemini

# Model id offered on your account, e.g. copy it from the AI Studio model list.
# Required in practice: model ids change often and the built-in default is a guess.
LLM_MODEL_NAME=

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# --- API keys: fill in only the one for the provider selected above ---------
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
